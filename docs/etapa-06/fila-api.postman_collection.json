            "description": "Execute antes 'Chamar próxima senha'. O ID usado vem de {{senhaAtendidaId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"novo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
